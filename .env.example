# ─── Google Gemini (required for AI lesson generation) ───────────────────
# Get a key at https://aistudio.google.com/apikey
# Without this the bot still runs, using the curated fallback lessons.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Instagram (only needed to publish; generation works without it) ─────
INSTAGRAM_USERNAME=your_instagram_username_here
INSTAGRAM_PASSWORD=your_instagram_password_here

# ─── Voice ───────────────────────────────────────────────────────────────
# Aliases: guy | jenny | brian | aria | emma | eric | ryan | sonia
# Or any full Edge-TTS voice id, e.g. en-US-GuyNeural
TTS_VOICE=guy

# ─── Branding ────────────────────────────────────────────────────────────
# Shown on card posts and thumbnails. Use your real IG handle.
BRAND_HANDLE=@DailyEnglishTips

# ─── Publishing policy ───────────────────────────────────────────────────
# review  = generate and hold for your approval (recommended)
# auto    = generate and upload unattended
PUBLISH_MODE=review

# Reshare each published reel to Stories as a tappable preview.
# Puts it in front of existing followers immediately; their early engagement
# is the first thing the algorithm reads. Set false to disable.
SHARE_TO_STORY=true

# ─── Render tuning ───────────────────────────────────────────────────────
VIDEO_FPS=24
CARD_DURATION_SEC=10
